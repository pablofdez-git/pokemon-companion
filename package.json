{
  "name": "pokemon-companion",
  "displayName": "pokemon-companion",
  "description": "Captura Pokémon salvajes mientras programas, gana monedas y mejora tu mochila de pokéballs.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
  "commands": [
    {
      "command": "pokemonCompanion.resetProgress",
      "title": "Pokémon Companion: Reiniciar progreso"
    },
    {
      "command": "pokemonCompanion.forceEncounter",
      "title": "Pokémon Companion: Forzar encuentro (pruebas)"
    },
    {
      "command": "pokemonCompanion.openShop",
      "title": "Pokémon Companion: Abrir tienda"
    },
    {
      "command": "pokemonCompanion.sellDuplicate",
      "title": "Vender un repetido",
      "icon": "$(tag)"
    }
  ],
  "menus": {
    "commandPalette": [
      {
        "command": "pokemonCompanion.sellDuplicate",
        "when": "false"
      }
    ],
    "view/item/context": [
      {
        "command": "pokemonCompanion.sellDuplicate",
        "when": "view == pokemonCompanion.backpack && viewItem == duplicatePokemon",
        "group": "inline"
      },
      {
        "command": "pokemonCompanion.sellDuplicate",
        "when": "view == pokemonCompanion.backpack && viewItem == duplicatePokemon",
        "group": "1_sell"
      }
    ]
  },
  "viewsContainers": {
    "activitybar": [
      {
        "id": "pokemonCompanion",
        "title": "Pokémon Companion",
        "icon": "media/backpack.svg"
      }
    ]
  },
  "views": {
    "pokemonCompanion": [
      {
        "id": "pokemonCompanion.backpack",
        "name": "Mochila",
        "icon": "media/backpack.svg"
      }
    ]
  }
},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
