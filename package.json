{
  "name": "pokemon-companion",
  "displayName": "Ctrl+Catch",
  "description": "Juego de fans: gana monedas al guardar tu código y captura Pokémon salvajes mientras programas.",
  "publisher": "pablofdez",
  "repository": {
    "type": "git",
    "url": "https://github.com/pablofdez-git/pokemon-companion.git"
  },
  "version": "0.7.0",
  "icon": "media/icon.png",
  "license": "MIT",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#312e81",
    "theme": "dark"
  },
  "keywords": [
    "pokemon",
    "game",
    "gamification",
    "juego",
    "productivity",
    "fun"
  ],
  "bugs": {
    "url": "https://github.com/pablofdez-git/pokemon-companion/issues"
  },
  "homepage": "https://github.com/pablofdez-git/pokemon-companion#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pokemonCompanion.resetProgress",
        "title": "Ctrl+Catch: Reiniciar progreso"
      },
      {
        "command": "pokemonCompanion.togglePause",
        "title": "Ctrl+Catch: Pausar o reanudar"
      },
      {
        "command": "pokemonCompanion.openShop",
        "title": "Ctrl+Catch: Abrir tienda"
      },
      {
        "command": "pokemonCompanion.openPokedex",
        "title": "Ctrl+Catch: Abrir Pokédex",
        "icon": "$(book)"
      },
      {
        "command": "pokemonCompanion.openAchievements",
        "title": "Ctrl+Catch: Abrir logros",
        "icon": "$(trophy)"
      },
      {
        "command": "pokemonCompanion.sellDuplicate",
        "title": "Vender un repetido",
        "icon": {
          "light": "media/sell-light.svg",
          "dark": "media/sell-dark.svg"
        }
      },
      {
        "command": "pokemonCompanion.evolve",
        "title": "Evolucionar",
        "icon": "$(arrow-circle-up)"
      },
      {
        "command": "pokemonCompanion.useObject",
        "title": "Usar",
        "icon": "$(play)"
      },
      {
        "command": "pokemonCompanion.openNursery",
        "title": "Ctrl+Catch: Abrir guardería"
      },
      {
        "command": "pokemonCompanion.chooseFavorite",
        "title": "Ctrl+Catch: Elegir Pokémon favorito"
      },
      {
        "command": "pokemonCompanion.clearFavorite",
        "title": "Ctrl+Catch: Quitar Pokémon favorito"
      },
      {
        "command": "pokemonCompanion.setFavorite",
        "title": "Elegir como favorito"
      },
      {
        "command": "pokemonCompanion.syncNow",
        "title": "Ctrl+Catch: Sincronizar partida ahora"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pokemonCompanion.sellDuplicate",
          "when": "false"
        },
        {
          "command": "pokemonCompanion.evolve",
          "when": "false"
        },
        {
          "command": "pokemonCompanion.useObject",
          "when": "false"
        },
        {
          "command": "pokemonCompanion.setFavorite",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "pokemonCompanion.setFavorite",
          "when": "view == pokemonCompanion.backpack && viewItem =~ /Pokemon/",
          "group": "3_favorite"
        },
        {
          "command": "pokemonCompanion.clearFavorite",
          "when": "view == pokemonCompanion.backpack && viewItem == favorite",
          "group": "3_favorite"
        },
        {
          "command": "pokemonCompanion.useObject",
          "when": "view == pokemonCompanion.backpack && viewItem == usableObject",
          "group": "inline"
        },
        {
          "command": "pokemonCompanion.useObject",
          "when": "view == pokemonCompanion.backpack && viewItem == usableObject",
          "group": "1_use"
        },
        {
          "command": "pokemonCompanion.evolve",
          "when": "view == pokemonCompanion.backpack && viewItem =~ /evolvable/",
          "group": "inline@0"
        },
        {
          "command": "pokemonCompanion.evolve",
          "when": "view == pokemonCompanion.backpack && viewItem =~ /evolvable/",
          "group": "2_evolve"
        },
        {
          "command": "pokemonCompanion.sellDuplicate",
          "when": "view == pokemonCompanion.backpack && viewItem =~ /duplicatePokemon/",
          "group": "inline"
        },
        {
          "command": "pokemonCompanion.sellDuplicate",
          "when": "view == pokemonCompanion.backpack && viewItem =~ /duplicatePokemon/",
          "group": "1_sell"
        }
      ],
      "view/title": [
        {
          "command": "pokemonCompanion.openPokedex",
          "when": "view == pokemonCompanion.backpack",
          "group": "navigation@1"
        },
        {
          "command": "pokemonCompanion.openAchievements",
          "when": "view == pokemonCompanion.backpack",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pokemonCompanion",
          "title": "Ctrl+Catch",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "pokemonCompanion": [
        {
          "type": "webview",
          "id": "pokemonCompanion.encounter",
          "name": "Encuentro",
          "icon": "media/sidebar.svg",
          "when": "!pokemonCompanion.paused"
        },
        {
          "id": "pokemonCompanion.backpack",
          "name": "Mochila",
          "icon": "media/sidebar.svg",
          "when": "!pokemonCompanion.paused"
        }
      ]
    },
    "configuration": {
      "title": "Ctrl+Catch",
      "properties": {
        "pokemonCompanion.syncFolder": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Carpeta donde guardar la copia de la partida para compartirla entre ordenadores. Si está vacía, se usa la carpeta `PokemonCompanion` dentro del OneDrive de este equipo."
        },
        "pokemonCompanion.encounterChance": {
          "type": "number",
          "default": 0.25,
          "minimum": 0.05,
          "maximum": 1,
          "scope": "application",
          "markdownDescription": "Probabilidad de que aparezca un Pokémon salvaje tras un guardado que da monedas (de `0.05` a `1`). Por defecto `0.25`."
        },
        "pokemonCompanion.encounterCooldownSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 3600,
          "scope": "application",
          "markdownDescription": "Segundos mínimos entre el final de un encuentro y el siguiente (de `10` a `3600`). Por defecto `60`."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && npm run compile",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
